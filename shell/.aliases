# Shell
# Easier navigation
alias up1="cd .."
alias up2="cd ../.."
alias up3="cd ../../.."
alias up4="cd ../../../.."
alias up5="cd ../../../../.."
alias up6="cd ../../../../../.."

alias ll='ls -laGF'
alias la='ls -laGF'
alias l="ls -laGF"

alias cls=clear

# Make Python 3 the default
alias python="/opt/homebrew/bin/python3 " 
alias pip="/opt/homebrew/bin/pip3 " 

# quick hosts
alias ehosts="sudo nano /etc/hosts"
alias hostfile="sudo nano /etc/hosts"
alias hosts="less /etc/hosts"

# SSH - clear loaded keys, edit config. copy key to clipboard
alias ck="ssh-add -D"
alias sshconfig="nano ~/.ssh/config"
alias copykey='command cat ~/.ssh/personal/deanlj.me.pub | pbcopy'
alias makekey='ssh-keygen -t ed25519'

# PHP
alias pu="vendor/bin/phpunit"
alias puw="phpunit-watcher watch"
alias art="php artisan"
alias artr="php artisan remote"
alias comp="composer"
alias compup="composer update"
alias compreq="composer require"
alias compi="composer install"
alias compdump="composer dump-autoload -o"
alias larastan="vendor/bin/phpstan analyse"
alias deploydev='php deploy dev -vvv'
alias deployqa='php deploy qa -vvv'
alias deployuat='php deploy uat -vvv'
alias deployprod='php deploy prod -vvv'
alias mfs='php artisan migrate:fresh --seed'
alias refresh='php artisan migrate:refresh --seed'

alias pp="php artisan test --parallel"
alias dusk="php artisan dusk"

# JavaScript
alias jest="./node_modules/.bin/jest"

# Git
alias gc="git checkout"
alias gpo="git push origin"
alias gm="git merge"
alias gr="git rebase "
alias glog="git log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gnah='git reset --hard;git clean -df'
alias gcdev='git checkout develop'
alias gcmain='git checkout main'
alias grem="git remote -v"

# Fast open
alias o="open ."

# PhpStorm
# alias phpstorm='open -a /Applications/PhpStorm.app "`pwd`"'
alias genide="art clear-compiled && art ide-helper:generate && art ide-helper:meta && art optimize"

# Redis
alias flush-redis="redis-cli FLUSHALL"

# VSCode
alias code='open -a "/Applications/Visual Studio Code.app" "`pwd`"'

# Show/hide hidden files in Finder
alias showfiles="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hidefiles="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

# IP addresses
alias ip="curl https://diagnostic.opendns.com/myip ; echo"
alias localip="ifconfig -a | grep -o 'inet6\? \(addr:\)\?\s\?\(\(\([0-9]\+\.\)\{3\}[0-9]\+\)\|[a-fA-F0-9:]\+\)' | awk '{ sub(/inet6? (addr:)? ?/, \"\"); print }'"

# Flush Directory Service cache
alias flushdns="sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder"

# Lock the screen
alias afk="osascript -e 'tell application \"System Events\" to keystroke \"q\" using {command down,control down}'"

# Empty the Trash on all mounted volumes and the main HDD
# Also, clear Apple’s System Logs to improve shell startup speed
alias emptytrash="sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl"

# Enable aliases to be sudo’ed
alias sudo='sudo '

# Scape webpage
alias scrape="scrapeUrl"

# Switch NPM
alias npmnpm="npm config set registry https://registry.npmjs.org"
alias npmspatie="npm config set registry https://npm.spatie.be"

# Docker aliases
# alias dcomp="docker-compose "
# alias dclean="docker rm $(docker ps -aq)"

# Terraform and AWS CLI for LocalStack
alias tf="tflocal "
alias tform="terraform "
alias tfinit="tflocal init "
alias tfplan="tflocal plan "
alias tfapply="tflocal apply "
alias tfdestroy="tflocal destroy "
alias tfoutput="tflocal output "
alias tfstate="tflocal state "
alias tfgraph="tflocal graph "
alias tfvalidate="tflocal validate "
alias tfws="tflocal workspace select "
alias tfwsc="tflocal workspace new "
alias tfwsl="tflocal workspace list "

alias awsl="awslocal --endpoint-url=http://localhost:4566"
alias lstack="docker run -p 4566:4566 -p 4510-4559:4510-4559 localstack/localstack"
alias lstackup="docker run -d -p 4566:4566 -p 4510-4559:4510-4559 localstack/localstack"
alias lstackdown='docker stop $(docker ps -aq --filter ancestor=localstack/localstack)'
alias lstacklogs='docker logs -f $(docker ps -aq --filter ancestor=localstack/localstack)'
alias lstackcli='docker exec -it $(docker ps -aq --filter ancestor=localstack/localstack) /bin/bash'

alias serena="uv run --directory $HOME/Projects/serena serena start-mcp-server"

alias cl="claude --channels plugin:fakechat@claude-plugins-official"